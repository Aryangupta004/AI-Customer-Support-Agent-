# SupportPilot AI — Personal Edition (Aryan)
# Copy to .env and fill in values:  cp .env.example .env

# Groq API (optional — app runs in offline fallback mode without it)
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Database — SQLite by default (zero-config). For Postgres, use:
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/supportpilot
DATABASE_URL=sqlite:///./supportpilot.db

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Server
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# Vector search
VECTOR_SEARCH_THRESHOLD=0.35
TOP_K_RESULTS=3
